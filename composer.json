{
    "name": "rta/elastic-logs",
    "description": "Monthly Elasticsearch log indices for Laravel: base search service, index template and maintenance commands.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/console": "^9.0|^10.0|^11.0",
        "elasticsearch/elasticsearch": "^8.19"
    },
    "autoload": {
        "psr-4": {
            "Rta\\ElasticLogs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rta\\ElasticLogs\\ElasticLogsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
